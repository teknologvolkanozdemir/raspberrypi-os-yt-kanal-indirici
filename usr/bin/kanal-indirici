#!/usr/bin/env python3
import os
import threading
import gi

gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, GLib
from yt_dlp import YoutubeDL


class KanalInciriciApp(Gtk.Window):

  def __init__(self):
    super().__init__(title="YouTube Kanal İndirici")
    self.set_border_width(20)
    self.set_default_size(450, 320)

    vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=15)
    self.add(vbox)

    self.lbl_url = Gtk.Label(label="Kanal veya Oynatma Listesi Bağlantısı:")
    self.lbl_url.set_alignment(0, 0)
    vbox.pack_start(self.lbl_url, False, False, 0)

    self.entry_url = Gtk.Entry()
    self.entry_url.set_placeholder_text("Buraya kanal bağlantısını yapıştırın")
    vbox.pack_start(self.entry_url, False, False, 0)

    self.lbl_format = Gtk.Label(label="İndirme Biçimi:")
    self.lbl_format.set_alignment(0, 0)
    vbox.pack_start(self.lbl_format, False, False, 0)

    hbox_radio = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=20)
    vbox.pack_start(hbox_radio, False, False, 0)

    self.rb_mp4 = Gtk.RadioButton.new_with_label(None, "Tüm Kanal Video (MP4)")
    hbox_radio.pack_start(self.rb_mp4, False, False, 0)

    self.rb_mp3 = Gtk.RadioButton.new_with_label_from_widget(
        self.rb_mp4, "Tüm Kanal Ses (MP3)"
    )
    hbox_radio.pack_start(self.rb_mp3, False, False, 0)

    self.btn_indir = Gtk.Button(label="Kanal İndirmeyi Başlat")
    self.btn_indir.connect("clicked", self.baslat_thread)
    vbox.pack_start(self.btn_indir, False, False, 0)

    self.lbl_durum = Gtk.Label(label="Hazır")
    self.lbl_durum.set_alignment(0, 0)
    vbox.pack_start(self.lbl_durum, False, False, 0)

    self.spinner = Gtk.Spinner()
    vbox.pack_start(self.spinner, False, False, 0)

  def baslat_thread(self, widget):
    url = self.entry_url.get_text().strip()
    if not url:
      self.lbl_durum.set_text("Hata: Lütfen geçerli bir kanal bağlantısı girin.")
      return

    self.btn_indir.set_sensitive(False)
    self.spinner.start()
    self.lbl_durum.set_text("Kanal taranıyor ve indiriliyor...")

    t = threading.Thread(target=self.indir, args=(url,))
    t.daemon = True
    t.start()

  def indir(self, url):
    secim = "mp3" if self.rb_mp3.get_active() else "mp4"
    kayit_yeri = os.path.expanduser("~/Downloads/YouTube-Kanallar")
    os.makedirs(kayit_yeri, exist_ok=True)

    if secim == "mp3":
      ydl_opts = {
          "format": "bestaudio/best",
          "outtmpl": os.path.join(
              kayit_yeri, "%(uploader)s/%(title)s.%(ext)s"
          ),
          "postprocessors": [
              {
                  "key": "FFmpegExtractAudio",
                  "preferredcodec": "mp3",
                  "preferredquality": "192",
              }
          ],
      }
    else:
      ydl_opts = {
          "format": "bestvideo[ext=mp4]+bestaudio[ext=m4a]/best[ext=mp4]/best",
          "outtmpl": os.path.join(
              kayit_yeri, "%(uploader)s/%(title)s.%(ext)s"
          ),
      }

    try:
      with YoutubeDL(ydl_opts) as ydl:
        ydl.download([url])
      GLib.idle_add(
          self.islem_bitti, True, f"Kanal indirildi: {kayit_yeri}"
      )
    except Exception as e:
      GLib.idle_add(self.islem_bitti, False, str(e))

  def islem_bitti(self, basarili, mesaj):
    self.spinner.stop()
    self.btn_indir.set_sensitive(True)
    self.lbl_durum.set_text(mesaj)
    dialog = Gtk.MessageDialog(
        transient_for=self,
        flags=0,
        message_type=Gtk.MessageType.INFO if basarili else Gtk.MessageType.ERROR,
        buttons=Gtk.ButtonsType.OK,
        text="Bilgi" if basarili else "Hata",
    )
    dialog.format_secondary_text(mesaj)
    dialog.run()
    dialog.destroy()


if __name__ == "__main__":
  win = KanalInciriciApp()
  win.connect("destroy", Gtk.main_quit)
  win.show_all()
  Gtk.main()
